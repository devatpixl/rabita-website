# Phase 1: DATABASE_URL is only needed if you run `prisma generate`. The
# giving flow uses the stub in app/api/donations/route.ts and does not touch
# Prisma. Switch provider in schema.prisma to postgresql before enabling in
# phase 2.
DATABASE_URL="file:./dev.db"

# IRN / bonnetid.no "Felles bønnetid" API — live prayer times (lib/irn.ts).
# Server-only; never prefix with NEXT_PUBLIC_. Without a token the site falls
# back to the static table in lib/prayer-times.ts.
IRN_API_BASE="https://api.bonnetid.no"
IRN_API_TOKEN=""
IRN_LOCATION_ID="181"          # Oslo
IRN_MOSQUE_ORG_NR="983228364"  # Rabita – Det Islamske Forbundet
